---
import Layout from '../../components/Layout.astro';
import { getAtlasData, isSummitResult } from '../../lib/content';
import { formatKm, formatMeters } from '../../lib/format';

const data = await getAtlasData();

const ascentsByFerrata = new Map<string, typeof data.ascents>();
for (const a of data.ascents) {
  if (!a.data.ferrata) continue;
  const id = a.data.ferrata.id;
  if (!ascentsByFerrata.has(id)) ascentsByFerrata.set(id, []);
  ascentsByFerrata.get(id)!.push(a);
}

const rows = data.ferratas.map((f) => {
  const ascents = ascentsByFerrata.get(f.id) ?? [];
  return { f, ascents, done: ascents.some((a) => isSummitResult(a.data.result)) };
});
---

<Layout title="Ferraty" description="Katalog via ferrat a historie výstupů.">
  <section class="container page-head">
    <p class="eyebrow">Hory</p>
    <h1>Via ferraty</h1>
    <nav class="subnav">
      <a href="/vrcholy">Vrcholy</a>
      <a href="/ferraty" aria-current="page">Ferraty</a>
      <a href="/hrebenovky">Hřebenovky</a>
    </nav>
  </section>

  <section class="container">
    {
      rows.length === 0 ? (
        <p class="text-muted">Zatím žádná ferrata - přidej ji přes `npm run new:ferrata`.</p>
      ) : (
        <div class="grid">
          {rows.map(({ f, ascents, done }) => (
            <a class="item-card" href={`/ferraty/${f.id}`}>
              <div class="item-card-top">
                <span class="text-faint">{f.data.country}{f.data.area ? ` · ${f.data.area}` : ''}</span>
                <span class={`badge ${done ? 'badge-done' : 'badge-open'}`}>{done ? 'zdoláno' : ascents.length > 0 ? 'pokus' : 'v katalogu'}</span>
              </div>
              <h3>{f.data.name}</h3>
              <span class="meta">
                {f.data.difficulty ? `Obtížnost ${f.data.difficulty}` : ''}
                {f.data.distanceKm ? ` · ${formatKm(f.data.distanceKm)}` : ''}
                {f.data.elevationGainM ? ` · ${formatMeters(f.data.elevationGainM)}` : ''}
              </span>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>

<style>
  .page-head {
    padding-block: var(--space-6) var(--space-4);
  }

  .subnav {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .subnav a {
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.5em 1.1em;
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    border: 1px solid var(--border-soft);
  }

  .subnav a[aria-current='page'] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-8);
  }

  .item-card {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .item-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .item-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }

  .badge {
    padding: 0.2em 0.7em;
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  .badge-done {
    background: rgba(124, 196, 143, 0.15);
    color: #7cc48f;
  }

  .badge-open {
    background: var(--bg-elevated-2);
    color: var(--text-faint);
  }

  .item-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
