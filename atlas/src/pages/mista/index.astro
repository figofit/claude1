---
import Layout from '../../components/Layout.astro';
import { getAtlasData } from '../../lib/content';
import { PLACE_TYPE_LABELS } from '../../lib/format';
import { PLACE_TYPES } from '../../content.config';

const data = await getAtlasData();

const typeCounts = new Map<string, number>();
for (const p of data.places) typeCounts.set(p.data.type, (typeCounts.get(p.data.type) ?? 0) + 1);
const typesPresent = PLACE_TYPES.filter((t) => typeCounts.has(t));

const tripsByPlace = new Map<string, Set<string>>();
const addTrip = (placeId: string, tripId: string) => {
  if (!tripsByPlace.has(placeId)) tripsByPlace.set(placeId, new Set());
  tripsByPlace.get(placeId)!.add(tripId);
};
for (const r of data.routes) {
  addTrip(r.data.from.id, r.data.trip.id);
  addTrip(r.data.to.id, r.data.trip.id);
}
for (const a of data.ascents) if (a.data.from) addTrip(a.data.from.id, a.data.trip.id);

const tripTitles = new Map(data.trips.map((t) => [t.id, t.data.title]));

const sorted = [...data.places].sort((a, b) => a.data.name.localeCompare(b.data.name, 'cs'));
---

<Layout title="Místa" description="Všechna zaznamenaná města, vesnice a další místa.">
  <section class="container page-head">
    <p class="eyebrow">Rejstřík</p>
    <h1>Místa</h1>
    <p class="text-muted">{sorted.length} {sorted.length === 1 ? 'místo v atlasu' : 'míst v atlasu'} (vrcholy mají vlastní sekci - <a href="/vrcholy">Hory</a>).</p>
  </section>

  {
    sorted.length > 0 && (
      <section class="container">
        <div class="type-filters" role="group" aria-label="Filtr podle typu místa">
          <button type="button" class="chip" data-type="all" aria-pressed="true">
            Vše <span class="chip-count">{sorted.length}</span>
          </button>
          {typesPresent.map((t) => (
            <button type="button" class="chip" data-type={t} aria-pressed="false">
              {PLACE_TYPE_LABELS[t]} <span class="chip-count">{typeCounts.get(t)}</span>
            </button>
          ))}
        </div>
      </section>
    )
  }

  <section class="container">
    {
      sorted.length === 0 ? (
        <p class="text-muted">Zatím žádné místo - přidej ho přes `npm run new:place`.</p>
      ) : (
        <div class="place-list" id="place-list">
          {sorted.map((p) => {
            const trips = [...(tripsByPlace.get(p.id) ?? [])].map((id) => tripTitles.get(id)).filter(Boolean);
            return (
              <div class="place-row" data-type={p.data.type}>
                <div>
                  <strong>{p.data.name}</strong>
                  <span class="text-faint"> · {p.data.country} · {PLACE_TYPE_LABELS[p.data.type]}</span>
                </div>
                <span class="text-muted place-trips">{trips.length > 0 ? trips.join(', ') : '—'}</span>
              </div>
            );
          })}
        </div>
      )
    }
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.type-filters .chip');
  const rows = document.querySelectorAll<HTMLElement>('#place-list .place-row');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type ?? 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      rows.forEach((row) => {
        row.hidden = type !== 'all' && row.dataset.type !== type;
      });
    });
  });
</script>

<style>
  .page-head {
    padding-block: var(--space-6) var(--space-4);
  }

  .page-head a {
    color: var(--accent);
    text-decoration: none;
  }

  .place-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border-soft);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }

  .place-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    background: var(--bg-elevated);
    padding: var(--space-3) var(--space-4);
  }

  .place-row[hidden] {
    display: none;
  }

  .place-trips {
    font-size: var(--text-sm);
    text-align: right;
  }

  .type-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .chip {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-elevated-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.45em 1em;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .chip:hover {
    color: var(--text);
  }

  .chip[aria-pressed='true'] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }

  .chip-count {
    opacity: 0.7;
    font-size: var(--text-xs);
  }
</style>
